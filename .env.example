# ==========================================
# DeployBD — Environment Variables
# ==========================================
# এই ফাইলটা .env নামে copy করে আপনার values বসান:
#   cp .env.example .env

# ==========================================
# 🔴 REQUIRED — Database
# ==========================================
# Neon / Supabase / Vercel Postgres থেকে পাওয়া connection string
DATABASE_URL=postgresql://user:password@host:5432/app_db

# ==========================================
# 🟡 OPTIONAL — bKash Payment Gateway
# ==========================================
# এইগুলো set না করলে app automatically sandbox/demo mode-এ চলবে
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Production-এর জন্য:
# BKASH_BASE_URL=https://checkout.pay.bka.sh/v1.2.0-beta

# ==========================================
# 🟡 OPTIONAL — Email Service (Resend)
# ==========================================
# Set না করলে email গুলো server log-এ print হবে (UI flow ঠিক থাকবে)
RESEND_API_KEY=
EMAIL_FROM="DeployBD <hello@deploybd.dev>"

# ==========================================
# 🟡 OPTIONAL — App URL
# ==========================================
# bKash callback URL বানাতে ব্যবহার হয়
NEXT_PUBLIC_APP_URL=http://localhost:3000
